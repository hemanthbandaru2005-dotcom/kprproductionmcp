{
  "rewrites": [
    {
      "source": "/app/api/drive/:path*",
      "destination": "https://kprproductionmcp.onrender.com/app/api/drive/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://kprproductionmcp.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
